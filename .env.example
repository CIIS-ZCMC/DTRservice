APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

DEFAULT_FIRST_IN=08:00:00
DEFAULT_FIRST_OUT=12:00:00
DEFAULT_LAST_IN=13:00:00
DEFAULT_LAST_OUT=17:00:00

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dtrservice
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Biometric Device Configuration
BIOMETRIC_DEFAULT_DEVICE=DEVICE_001
BIOMETRIC_SYNC_TIMEOUT=30
BIOMETRIC_SYNC_RETRY_ATTEMPTS=3
BIOMETRIC_SYNC_RETRY_DELAY=5
BIOMETRIC_DEVICE_001_IP=192.168.1.100
BIOMETRIC_DEVICE_001_PORT=80

# DTR Report Access Token
DTR_ACCESS_TOKEN="DTRtoken"

# ZKTeco Inbound Punch Ingestion API & ADMS Integration Server (Port 8080)
# When co-hosted on 192.168.9.243, use http://127.0.0.1:8080 (loopback)
ZK_SERVER_FORWARD_ENABLED=true
ZK_SERVER_HOST=http://127.0.0.1:8080
ZK_SERVER_TIMEOUT=3
ZK_SERVER_DEVICE_SN=DTRSERVICE_8181
ZK_SERVER_BATCH_SIZE=50
# Specific device IDs permitted to forward to ZKTeco (leave blank or * for all devices, or e.g. 7,14)
ZK_FORWARD_DEVICE_IDS=
# When true, maps canonical biometric_id to hrbliz_biometric_id before sending to Port 8080 (e.g. 493 -> 5180)
ZK_FORWARD_USE_HRBLIZ_ID=true


